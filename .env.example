# Public, build-time browser defaults. Restart Vite after editing.
# Copy to .env.local to override. Do not put secrets in VITE_ variables.
VITE_STYLE=coastal
# Independent world ingredients. Scene presets live in src/config/scenes.json.
# Optional: greenridge / summer-coast / coastal-rain / city-afterglow /
# desert-quiet / alpine-lakes / tallwood. Explicit VITE_ values below
# override a scene's ingredients; comment those values out to use the recipe.
# VITE_SCENE=summer-coast
# highlands / coast / city / desert / lakes / forest; spring / summer / autumn / winter
VITE_LANDSCAPE=coast
VITE_SEASON=summer
# day / sunset / dusk / night / dawn; clear / overcast / rain / snow
VITE_TIME_OF_DAY=day
VITE_WEATHER=clear
VITE_WEATHER_INTENSITY=0.5
VITE_WIND=0.25
# The world clock runs only while driving, not in menus, pause, or the garage.
# Four equal phases: daylight -> sunset -> moonlight -> dawn. Blue hour stays selectable.
VITE_AUTO_TIME=true
VITE_AUTO_SEASONS=true
VITE_AUTO_WEATHER=true
# Seconds per full day (600 = 10 minutes; each phase = 2.5 minutes).
VITE_DAY_DURATION=600
# Full driving days per season. Seasons follow spring -> summer -> autumn -> winter.
VITE_SEASON_DAYS=3
# Independent weather interval in seconds; weather never changes vehicle grip.
VITE_WEATHER_DURATION=210
# asphalt / gravel; dashed / double / none; posts / barriers
VITE_ROAD_SURFACE=asphalt
VITE_ROAD_MARKINGS=dashed
VITE_ROADSIDE=posts
# astra, renault-12, testarossa, porsche-911, camaro-ss, mustang-fastback, wagon, peugeot-206
VITE_CAR=astra
# Restore-defaults seed. Fresh page loads automatically choose a new route.
VITE_WORLD_SEED=42
VITE_ROAD_CURVES=1
# 0.6 = shorter bends, 1 = default, 1.6 = longer curves. Straights stay capped.
VITE_CURVE_LENGTH=1
# 0 = twistier, 0.5 = balanced, 1 = more long sweeps
VITE_CURVE_MIX=0.5
VITE_ROAD_WIDTH=10
VITE_HILL_GRADE=0.09
VITE_TERRAIN_HEIGHT=1
VITE_TREE_DENSITY=1
# 0 = angular low poly, 1 = rounded shapes and smooth terrain.
VITE_SHAPE_SOFTNESS=0.65
VITE_FOG=0.5
VITE_CRUISE_SPEED=36
VITE_MAX_SPEED=280
VITE_DRIFT=0.55
VITE_TIRE_SMOKE=0.65
VITE_PIXEL_RATIO=1.75
# Display only: auto (country, with locale fallback), metric, or imperial. Physics/config values stay metric.
# VITE_UNITS=auto
